{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectflow",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projectflow-db",
      "database_id": "53e2d61e-7877-435d-87e0-c2de74215e42",
      "migrations_dir": "apps/api/prisma/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "RealtimeRoom" }]
  },
  "exports": {
    "RealtimeRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "CLIENT_ORIGIN": "https://projectflow.shivraj.me"
  },
  "routes": [
    {
      "pattern": "projectflow.shivraj.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}